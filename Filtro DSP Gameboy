        "\"\"\"\n",
        "Filtro Game Boy (pixel art) - Projeto de Processamento Digital de Sinais\n",
        "\n",
        "Pipeline (cada etapa tem um conceito de PDS por trás):\n",
        "  1. Conversão para luminância (escala de cinza)\n",
        "  2. Corte central na proporção 160:144 (tela do Game Boy)\n",
        "  3. Realce de contraste (alongamento de histograma por percentis)\n",
        "  4. Filtro passa-baixa Gaussiano (anti-aliasing, Nyquist)\n",
        "  5. Decimação (reamostragem) para 160x144\n",
        "  6. Quantização para 4 níveis (2 bits), com ou sem dithering:\n",
        "       - none : quantização simples por limiares\n",
        "       - bayer: dithering ordenado (matriz de Bayer 4x4)\n",
        "       - floyd: difusão de erro de Floyd-Steinberg (noise shaping)\n",
        "  7. Mapeamento para a paleta verde do Game Boy\n",
        "  8. Ampliação por vizinho mais próximo\n",
        "\n",
        "Uso:\n",
        "  python gameboy_filter.py foto.jpg                       # saída: foto_gameboy.png\n",
        "  python gameboy_filter.py foto.jpg -d floyd -s 5         # Floyd-Steinberg, escala 5x\n",
        "  python gameboy_filter.py foto.jpg --no-lowpass          # mostra o aliasing\n",
        "  python gameboy_filter.py foto.jpg --report              # gera figuras de análise\n",
        "\"\"\"\n",
        "\n",
        "import argparse\n",
        "import os\n",
        "import sys\n",
        "\n",
        "import cv2\n",
        "import numpy as np\n",
        "\n",
        "GB_W, GB_H = 160, 144\n",
        "\n",
        "# Paleta clássica do Game Boy (RGB), do mais escuro ao mais claro\n",
        "PALETTE = np.array(\n",
        "    [\n",
        "        [15, 56, 15],     # #0f380f\n",
        "        [48, 98, 48],     # #306230\n",
        "        [139, 172, 15],   # #8bac0f\n",
        "        [155, 188, 15],   # #9bbc0f\n",
        "    ],\n",
        "    dtype=np.uint8,\n",
        ")\n",
        "LEVEL_VALUES = np.array([0, 85, 170, 255], dtype=np.float64)  # 4 níveis de cinza\n",
        "\n",
        "BAYER_4X4 = np.array(\n",
        "    [\n",
        "        [0, 8, 2, 10],\n",
        "        [12, 4, 14, 6],\n",
        "        [3, 11, 1, 9],\n",
        "        [15, 7, 13, 5],\n",
        "    ],\n",
        "    dtype=np.float64,\n",
        ")\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------------------------\n",
        "# Etapas do pipeline\n",
        "# ----------------------------------------------------------------------------\n",
        "def to_luminance(img_bgr: np.ndarray) -> np.ndarray:\n",
        "    \"\"\"Y = 0.299 R + 0.587 G + 0.114 B  (retorna float64 em [0, 255]).\"\"\"\n",
        "    b, g, r = img_bgr[..., 0], img_bgr[..., 1], img_bgr[..., 2]\n",
        "    return 0.299 * r + 0.587 * g + 0.114 * b\n",
        "\n",
        "\n",
        "def center_crop_to_aspect(gray: np.ndarray, w: int = GB_W, h: int = GB_H) -> np.ndarray:\n",
        "    \"\"\"Corta a região central com a mesma proporção do Game Boy (10:9).\"\"\"\n",
        "    H, W = gray.shape\n",
        "    target = w / h\n",
        "    if W / H > target:                       # imagem larga demais\n",
        "        new_w = int(round(H * target))\n",
        "        x0 = (W - new_w) // 2\n",
        "        return gray[:, x0:x0 + new_w]\n",
        "    new_h = int(round(W / target))           # imagem alta demais\n",
        "    y0 = (H - new_h) // 2\n",
        "    return gray[y0:y0 + new_h, :]\n",
        "\n",
        "\n",
        "def stretch_contrast(gray: np.ndarray, low_pct: float = 1.0, high_pct: float = 99.0) -> np.ndarray:\n",
        "    \"\"\"Alongamento de histograma por percentis: usa melhor os 4 níveis.\"\"\"\n",
        "    lo, hi = np.percentile(gray, [low_pct, high_pct])\n",
        "    if hi - lo < 1e-6:\n",
        "        return gray.copy()\n",
        "    return np.clip((gray - lo) / (hi - lo) * 255.0, 0, 255)\n",
        "\n",
        "\n",
        "def lowpass(gray: np.ndarray, factor: float) -> np.ndarray:\n",
        "    \"\"\"\n",
        "    Passa-baixa Gaussiano antes de decimar.\n",
        "    Decimar por 'factor' exige frequência de corte ~ 0.5/factor (ciclos/pixel),\n",
        "    o que corresponde a sigma ~ 0.5 * factor no domínio espacial.\n",
        "    \"\"\"\n",
        "    sigma = max(0.5, 0.5 * factor)\n",
        "    return cv2.GaussianBlur(gray, (0, 0), sigmaX=sigma, sigmaY=sigma)\n",
        "\n",
        "\n",
        "def decimate(gray: np.ndarray, use_lowpass: bool = True) -> np.ndarray:\n",
        "    \"\"\"Reduz para 160x144. Sem passa-baixa usa vizinho mais próximo (gera aliasing).\"\"\"\n",
        "    factor = gray.shape[1] / GB_W\n",
        "    g = gray.astype(np.float32)\n",
        "    if use_lowpass and factor > 1.0:\n",
        "        g = lowpass(g, factor)\n",
        "        interp = cv2.INTER_AREA\n",
        "    else:\n",
        "        interp = cv2.INTER_NEAREST if not use_lowpass else cv2.INTER_AREA\n",
        "    return cv2.resize(g, (GB_W, GB_H), interpolation=interp).astype(np.float64)\n",
        "\n",
        "\n",
        "def quantize_simple(gray: np.ndarray) -> np.ndarray:\n",
        "    \"\"\"Quantização uniforme em 4 níveis (retorna índices 0..3).\"\"\"\n",
        "    return np.clip(np.floor(gray / 256.0 * 4.0), 0, 3).astype(np.uint8)\n",
        "\n",
        "\n",
        "def quantize_bayer(gray: np.ndarray) -> np.ndarray:\n",
        "    \"\"\"Dithering ordenado com matriz de Bayer 4x4 (limiar espacialmente periódico).\"\"\"\n",
        "    h, w = gray.shape\n",
        "    thr = (BAYER_4X4 + 0.5) / 16.0 - 0.5                    # em (-0.5, 0.5)\n",
        "    thr = np.tile(thr, (h // 4 + 1, w // 4 + 1))[:h, :w]\n",
        "    v = gray / 255.0 * 3.0 + thr                             # escala 0..3\n",
        "    return np.clip(np.floor(v + 0.5), 0, 3).astype(np.uint8)\n",
        "\n",
        "\n",
        "def quantize_floyd_steinberg(gray: np.ndarray) -> np.ndarray:\n",
        "    \"\"\"Difusão de erro de Floyd-Steinberg (varredura em linhas, esquerda -> direita).\"\"\"\n",
        "    img = gray.astype(np.float64).copy()\n",
        "    h, w = img.shape\n",
        "    idx = np.zeros((h, w), dtype=np.uint8)\n",
        "    for y in range(h):\n",
        "        for x in range(w):\n",
        "            old = img[y, x]\n",
        "            k = int(np.clip(np.round(old / 85.0), 0, 3))\n",
        "            idx[y, x] = k\n",
        "            err = old - LEVEL_VALUES[k]\n",
        "            if x + 1 < w:\n",
        "                img[y, x + 1] += err * 7 / 16\n",
        "            if y + 1 < h:\n",
        "                if x > 0:\n",
        "                    img[y + 1, x - 1] += err * 3 / 16\n",
        "                img[y + 1, x] += err * 5 / 16\n",
        "                if x + 1 < w:\n",
        "                    img[y + 1, x + 1] += err * 1 / 16\n",
        "    return idx\n",
        "\n",
        "\n",
        "QUANTIZERS = {\n",
        "    \"none\": quantize_simple,\n",
        "    \"bayer\": quantize_bayer,\n",
        "    \"floyd\": quantize_floyd_steinberg,\n",
        "}\n",
        "\n",
        "\n",
        "def apply_palette(idx: np.ndarray) -> np.ndarray:\n",
        "    \"\"\"Índices 0..3 -> imagem RGB com a paleta do Game Boy.\"\"\"\n",
        "    return PALETTE[idx]\n",
        "\n",
        "\n",
        "def upscale(rgb: np.ndarray, scale: int) -> np.ndarray:\n",
        "    return cv2.resize(rgb, (rgb.shape[1] * scale, rgb.shape[0] * scale),\n",
        "                      interpolation=cv2.INTER_NEAREST)\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------------------------\n",
        "# Pipeline completo\n",
        "# ----------------------------------------------------------------------------\n",
        "def gameboy_filter(img_bgr, dither=\"floyd\", use_lowpass=True, contrast=True):\n",
        "    \"\"\"Retorna (índices 0..3, imagem cinza decimada pré-quantização).\"\"\"\n",
        "    gray = to_luminance(img_bgr.astype(np.float64))\n",
        "    gray = center_crop_to_aspect(gray)\n",
        "    if contrast:\n",
        "        gray = stretch_contrast(gray)\n",
        "    small = decimate(gray, use_lowpass=use_lowpass)\n",
        "    idx = QUANTIZERS[dither](small)\n",
        "    return idx, small\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------------------------\n",
        "# Métricas e análise (para o relatório)\n",
        "# ----------------------------------------------------------------------------\n",
        "def psnr(a: np.ndarray, b: np.ndarray) -> float:\n",
        "    mse = np.mean((a.astype(np.float64) - b.astype(np.float64)) ** 2)\n",
        "    return float(\"inf\") if mse == 0 else 10 * np.log10(255.0 ** 2 / mse)\n",
        "\n",
        "\n",
        "def log_spectrum(gray: np.ndarray) -> np.ndarray:\n",
        "    \"\"\"Magnitude da FFT 2D (log), centrada, com janela de Hann para reduzir vazamento.\"\"\"\n",
        "    g = gray - gray.mean()\n",
        "    win = np.outer(np.hanning(g.shape[0]), np.hanning(g.shape[1]))\n",
        "    F = np.fft.fftshift(np.fft.fft2(g * win))\n",
        "    return np.log1p(np.abs(F))\n",
        "\n",
        "\n",
        "def make_report(img_bgr, out_prefix, scale):\n",
        "    import matplotlib\n",
        "    matplotlib.use(\"Agg\")\n",
        "    import matplotlib.pyplot as plt\n",
        "\n",
        "    gray_full = center_crop_to_aspect(stretch_contrast(to_luminance(img_bgr.astype(np.float64))))\n",
        "    small_lp = decimate(gray_full, use_lowpass=True)\n",
        "    small_nolp = decimate(gray_full, use_lowpass=False)\n",
        "\n",
        "    # --- Figura 1: comparação de métodos de quantização -----------------------\n",
        "    fig, axes = plt.subplots(2, 4, figsize=(16, 7.5))\n",
        "    axes[0, 0].imshow(small_lp, cmap=\"gray\", vmin=0, vmax=255)\n",
        "    axes[0, 0].set_title(\"Cinza 160x144 (referência)\")\n",
        "    results = {}\n",
        "    for ax, (name, label) in zip(axes[0, 1:], [(\"none\", \"Quantização simples\"),\n",
        "                                               (\"bayer\", \"Dithering Bayer 4x4\"),\n",
        "                                               (\"floyd\", \"Floyd-Steinberg\")]):\n",
        "        idx = QUANTIZERS[name](small_lp)\n",
        "        rgb = apply_palette(idx)\n",
        "        ref = LEVEL_VALUES[idx]\n",
        "        # PSNR após suavizar, pois dithering troca resolução de nível por resolução espacial\n",
        "        p_raw = psnr(small_lp, ref)\n",
        "        p_blur = psnr(cv2.GaussianBlur(small_lp, (0, 0), 1.2),\n",
        "                      cv2.GaussianBlur(ref, (0, 0), 1.2))\n",
        "        results[name] = (p_raw, p_blur)\n",
        "        ax.imshow(rgb)\n",
        "        ax.set_title(f\"{label}\\nPSNR {p_raw:.1f} dB | suavizado {p_blur:.1f} dB\")\n",
        "    for ax in axes[0]:\n",
        "        ax.axis(\"off\")\n",
        "\n",
        "    # Histogramas (antes e depois)\n",
        "    axes[1, 0].hist(small_lp.ravel(), bins=64, color=\"gray\")\n",
        "    axes[1, 0].set_title(\"Histograma antes da quantização\")\n",
        "    for ax, name in zip(axes[1, 1:], [\"none\", \"bayer\", \"floyd\"]):\n",
        "        idx = QUANTIZERS[name](small_lp)\n",
        "        counts = np.bincount(idx.ravel(), minlength=4)\n",
        "        ax.bar(range(4), counts, color=[tuple(c / 255 for c in p) for p in PALETTE],\n",
        "               edgecolor=\"black\")\n",
        "        ax.set_xticks(range(4))\n",
        "        ax.set_title(f\"Níveis usados ({name})\")\n",
        "    plt.tight_layout()\n",
        "    f1 = f\"{out_prefix}_relatorio_dithering.png\"\n",
        "    plt.savefig(f1, dpi=130)\n",
        "    plt.close(fig)\n",
        "\n",
        "    # --- Figura 2: efeito do filtro passa-baixa (aliasing) --------------------\n",
        "    fig, axes = plt.subplots(2, 3, figsize=(14, 8))\n",
        "    axes[0, 0].imshow(gray_full, cmap=\"gray\", vmin=0, vmax=255)\n",
        "    axes[0, 0].set_title(f\"Original recortada ({gray_full.shape[1]}x{gray_full.shape[0]})\")\n",
        "    axes[0, 1].imshow(small_nolp, cmap=\"gray\", vmin=0, vmax=255)\n",
        "    axes[0, 1].set_title(\"Decimação SEM passa-baixa (aliasing)\")\n",
        "    axes[0, 2].imshow(small_lp, cmap=\"gray\", vmin=0, vmax=255)\n",
        "    axes[0, 2].set_title(\"Decimação COM passa-baixa\")\n",
        "    axes[1, 0].imshow(log_spectrum(gray_full), cmap=\"magma\")\n",
        "    axes[1, 0].set_title(\"Espectro |FFT2| - original\")\n",
        "    axes[1, 1].imshow(log_spectrum(small_nolp), cmap=\"magma\")\n",
        "    axes[1, 1].set_title(\"Espectro - sem passa-baixa\")\n",
        "    axes[1, 2].imshow(log_spectrum(small_lp), cmap=\"magma\")\n",
        "    axes[1, 2].set_title(\"Espectro - com passa-baixa\")\n",
        "    for ax in axes.ravel():\n",
        "        ax.axis(\"off\")\n",
        "    plt.tight_layout()\n",
        "    f2 = f\"{out_prefix}_relatorio_aliasing.png\"\n",
        "    plt.savefig(f2, dpi=130)\n",
        "    plt.close(fig)\n",
        "\n",
        "    # --- Imagens finais de cada método ---------------------------------------\n",
        "    for name in QUANTIZERS:\n",
        "        idx = QUANTIZERS[name](small_lp)\n",
        "        out = upscale(apply_palette(idx), scale)\n",
        "        cv2.imwrite(f\"{out_prefix}_gameboy_{name}.png\", cv2.cvtColor(out, cv2.COLOR_RGB2BGR))\n",
        "\n",
        "    print(\"Relatório gerado:\")\n",
        "    print(\" \", f1)\n",
        "    print(\" \", f2)\n",
        "    for name, (p_raw, p_blur) in results.items():\n",
        "        print(f\"  {name:>6}: PSNR {p_raw:.2f} dB | PSNR suavizado {p_blur:.2f} dB\")\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------------------------\n",
        "# CLI\n",
        "# ----------------------------------------------------------------------------\n",
        "def main(args_list=None):\n",
        "    ap = argparse.ArgumentParser(description=\"Filtro de imagem estilo Game Boy (PDS)\")\n",
        "    ap.add_argument(\"input\", help=\"imagem de entrada\")\n",
        "    ap.add_argument(\"-o\", \"--output\", help=\"arquivo de saída (padrão: <entrada>_gameboy.png)\")\n",
        "    ap.add_argument(\"-d\", \"--dither\", choices=list(QUANTIZERS), default=\"floyd\",\n",
        "                    help=\"método de quantização (padrão: floyd)\")\n",
        "    ap.add_argument(\"-s\", \"--scale\", type=int, default=4, help=\"fator de ampliação (padrão: 4)\")\n",
        "    ap.add_argument(\"--no-lowpass\", action=\"store_true\",\n",
        "                    help=\"desliga o filtro anti-aliasing (para demonstrar aliasing)\")\n",
        "    ap.add_argument(\"--no-contrast\", action=\"store_true\", help=\"desliga o realce de contraste\")\n",
        "    ap.add_argument(\"--report\", action=\"store_true\",\n",
        "                    help=\"gera figuras de análise (dithering, aliasing, espectros, PSNR)\")\n",
        "\n",
        "    # Se executando no Jupyter/Colab sem argumentos passados, evita falhar por causa dos argumentos do kernel\n",
        "    if args_list is None and any(arg.startswith(\"-f\") for arg in sys.argv):\n",
        "        args = ap.parse_args(args=[])\n",
        "    else:\n",
        "        args = ap.parse_args(args_list)\n",
        "\n",
        "    img = cv2.imread(args.input, cv2.IMREAD_COLOR)\n",
        "    if img is None:\n",
        "        raise SystemExit(f\"Não foi possível abrir: {args.input}\")\n",
        "\n",
        "    base = os.path.splitext(args.output or args.input)[0]\n",
        "    if args.report:\n",
        "        make_report(img, base, args.scale)\n",
        "        return\n",
        "\n",
        "    idx, _ = gameboy_filter(img, dither=args.dither,\n",
        "                            use_lowpass=not args.no_lowpass,\n",
        "                            contrast=not args.no_contrast)\n",
        "    out = upscale(apply_palette(idx), args.scale)\n",
        "    out_path = args.output or f\"{base}_gameboy.png\"\n",
        "    cv2.imwrite(out_path, cv2.cvtColor(out, cv2.COLOR_RGB2BGR))\n",
        "    print(f\"Salvo em {out_path} ({out.shape[1]}x{out.shape[0]})\")\n",
        "\n",
        "\n",
        "# Evita que quebre no ambiente interativo ao definir a célula, chamando apenas se executado diretamente por terminal\n",
        "if __name__ == \"__main__\" and not any(arg.startswith(\"-f\") for arg in sys.argv):\n",
        "    main()\n"
      ]
    },
